# Exemplo — copie para .env e preencha com suas chaves do Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI

# Google Sign-In
# Obtenha no Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Tipo "Web application" — usado pelo Supabase para validar o id_token no backend
GOOGLE_WEB_CLIENT_ID=SEU_WEB_CLIENT_ID.apps.googleusercontent.com

# Google Books API Key (OPCIONAL)
# Sem chave: limite de ~1.000 req/dia por IP (suficiente para uso pessoal).
# Com chave: limite de 1.000 req/dia por projeto (cota gratuita).
# Obtenha em: https://console.cloud.google.com → Biblioteca → "Books API" → Ativar → Credenciais
# GOOGLE_BOOKS_API_KEY=SUA_CHAVE_AQUI
