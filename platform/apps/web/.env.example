# Web Platform — app.lumen.app
# Copie para .env.local e preencha os valores

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# URL pública desta app (server-side runtime — sem NEXT_PUBLIC_ prefix)
APP_URL=https://app.lumen.app
# Mantido para compatibilidade com client components
NEXT_PUBLIC_APP_URL=https://app.lumen.app
