{
  "name": "@lumen/admin",
  "version": "0.1.0",
  "private": true,
  "description": "Lumen Admin Console — admin.lumen.app. Ferramenta interna do time Lumen.",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "build:vercel": "[ -d .next ] && echo 'Skipping next build — already built by turbo' || next build",
