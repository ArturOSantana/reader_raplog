    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lumen/types": "*",
    "@lumen/ui": "*",
    "@lumen/supabase": "*",
    "next": "15.5.22",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@supabase/supabase-js": "2.50.0",
    "@supabase/ssr": "0.6.1",
    "recharts": "3.10.1",
    "lucide-react": "0.525.0",
    "date-fns": "4.1.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.5",
    "typescript": "5.8.3",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "tailwindcss": "4.1.11",
    "@tailwindcss/postcss": "4.1.11",
    "postcss": "8.5.23"
  }
