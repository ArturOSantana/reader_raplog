# Admin Console — admin.lumen.app
# Copie para .env.local e preencha os valores
# NUNCA compartilhe este arquivo ou commite valores reais

# Supabase (mesma instância das outras apps)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# URL pública desta app
NEXT_PUBLIC_APP_URL=https://admin.lumen.app
