<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout do Widget Livro Atual.
  Tamanhos: Medium (4×2), Large (4×4).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_book_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/tv_book_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tv_book_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_text_secondary"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tv_book_pages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Página 0"
        android:textSize="13sp"
        android:textColor="@color/widget_text_secondary"
        android:layout_marginTop="8dp" />

    <ProgressBar
        android:id="@+id/pb_book_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/widget_accent"
        android:progressBackgroundTint="@color/widget_progress_bg" />

    <TextView
        android:id="@+id/tv_book_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textSize="12sp"
        android:textColor="@color/widget_accent"
        android:layout_marginTop="4dp" />

</LinearLayout>
