<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout do Widget Painel do Leitor.
  Tamanho: Large (4×4).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- Livro atual -->
    <TextView
        android:id="@+id/tv_dash_book_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tv_dash_book_pages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/tv_dash_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0 dias"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_dash_book"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/widget_accent"
        android:progressBackgroundTint="@color/widget_progress_bg" />

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_divider" />

    <!-- Meta diária -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meta  "
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/tv_dash_goal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0/0 pág."
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_dash_goal"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/widget_accent"
        android:progressBackgroundTint="@color/widget_progress_bg" />

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_divider" />

    <!-- Frase -->
    <TextView
        android:id="@+id/tv_dash_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:textStyle="italic"
        android:textColor="@color/widget_text_secondary"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Clube -->
    <TextView
        android:id="@+id/tv_dash_club"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_accent"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
